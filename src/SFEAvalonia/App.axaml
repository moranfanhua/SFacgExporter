<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SFExporter.Desktop.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button"><Setter Property="Padding" Value="16,9" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#F07835" /><Setter Property="Foreground" Value="White" /></Style>
  </Application.Styles>
</Application>
