<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SFExporter.AndroidApp.MobileApp" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button"><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="14,10" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="44" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#F07835" /><Setter Property="Foreground" Value="White" /></Style>
  </Application.Styles>
</Application>
